# SHACL shapes for the six kinds of source record in "White Repopulation:
# Reproduction without Preservation" (vocabulary white-repopulation.ttl).
#
# The shapes hold records after conversion to RDF by records.context.jsonld.
# They state what a record of each kind must carry to be read at all: its
# status, its locators and reading status, its limits, and the closed sets
# (legislative states, evidence statuses, reading grades) it may use. They
# do not judge whether a record's numbers are right; tests/test_reproduction.py
# recomputes those. Hand-declared for now: the record kinds have no Science JSON
# Schemas yet, and the shapes should be regenerated by
# json-schema-to-owl-shacl-service when they do.

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns:      <https://561.group/ns/> .
@prefix wr:      <https://561.group/knowledge/white-repopulation#> .
@prefix m:       <https://561.group/knowledge/white-repopulation/measure#> .
@prefix wrs:     <https://561.group/knowledge/white-repopulation/shapes#> .

<https://561.group/knowledge/white-repopulation/shapes>
    a owl:Ontology ;
    owl:versionIRI <https://561.group/knowledge/white-repopulation/shapes/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    owl:imports <https://561.group/knowledge/white-repopulation> ;
    dcterms:title "White Repopulation record shapes"@en ;
    dcterms:description "SHACL shapes for the six kinds of source record the White Repopulation paper computes from."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

# --- Shared nested shapes -----------------------------------------------------

wrs:SourceReferenceShape
    a sh:NodeShape ;
    sh:targetObjectsOf wr:citesSource , wr:sourceRecord ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:url ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wr:sourceGrade ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:readingGrade ; sh:in ( wr:FullPrimaryText wr:PublisherAbstract wr:EditedTranscription wr:SecondaryReport ) ] .

wrs:EvidenceStatusShape
    a sh:NodeShape ;
    sh:targetSubjectsOf wr:evidenceStatus ;
    sh:property [ sh:path wr:evidenceStatus ; sh:in ( wr:Observed wr:MechanisticallyPlausible wr:NotEstablished ) ] .

# --- Birth reconstruction -------------------------------------------------------

wrs:BirthReconstructionShape
    a sh:NodeShape ;
    sh:targetClass wr:BirthReconstruction ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ns:limitation ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A birth reconstruction states its limitations." ] ;
    sh:property [ sh:path wr:citesSource ; sh:minCount 1 ] ;
    sh:property [ sh:path wr:annualBirths ; sh:minCount 1 ; sh:node wrs:AnnualBirthsShape ] ;
    sh:property [ sh:path ( wr:captiveBirthsByDecade [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path wr:meanPopulation1790s ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path wr:assumedCrudeBirthRate1790sPerThousand ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minExclusive 0 ; sh:maxExclusive 1000 ;
        sh:message "The assumed 1790s crude birth rate is stated once, as births per thousand." ] ;
    sh:property [ sh:path wr:sensitivity ; sh:minCount 1 ; sh:node wrs:SensitivityShape ;
        sh:message "A birth reconstruction states how its assumed rate moves the share." ] .

wrs:AnnualBirthsShape
    a sh:NodeShape ;
    sh:property [ sh:path wr:year ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1700 ; sh:maxInclusive 1900 ] ;
    sh:property [ sh:path wr:birthsThousands ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] .

wrs:SensitivityShape
    a sh:NodeShape ;
    sh:property [ sh:path wr:assumedRate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path m:share_1790_1849_pct ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
    sh:property [ sh:path m:share_1790_1859_pct ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100 ] .

# --- Case register ---------------------------------------------------------------

wrs:CaseRegisterShape
    a sh:NodeShape ;
    sh:targetClass wr:CaseRegister ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:selectionRule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:universeNotAscertained ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue true ;
        sh:message "A purposive case register states that its universe is not ascertained." ] ;
    sh:property [ sh:path wr:hasCase ; sh:minCount 1 ; sh:class wr:CaseRecord ] ;
    sh:property [ sh:path ( wr:summary ns:forbiddenInference ) ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A case register states the inferences its summary forbids." ] .

wrs:CaseRecordShape
    a sh:NodeShape ;
    sh:targetObjectsOf wr:hasCase ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path wr:caseName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:jurisdiction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:decisionYear ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1600 ; sh:maxInclusive 1870 ] ;
    sh:property [ sh:path wr:citation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wr:sourceLocator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ns:readStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "Every case states how much of its source was read." ] ;
    sh:property [ sh:path wr:person ; sh:minCount 1 ] ;
    sh:property [ sh:path wr:caseObservation ; sh:minCount 1 ; sh:node wrs:CaseObservationShape ] ;
    sh:property [ sh:path ns:limitation ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "Every case states the limits on reading it." ] .

wrs:CaseObservationShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path wr:predicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:value ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path wr:location ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# --- Primary testimony extraction --------------------------------------------------

wrs:TestimonyExtractionShape
    a sh:NodeShape ;
    sh:targetClass wr:TestimonyExtraction ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:compiledOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path wr:sourceIdentity ; sh:minCount 1 ; sh:maxCount 1 ; sh:node wrs:TestimonySourceIdentityShape ] ;
    sh:property [ sh:path wr:testimonyObservation ; sh:minCount 1 ; sh:node wrs:TestimonyObservationShape ] ;
    sh:property [ sh:path wr:secondaryInterpretation ; sh:node wrs:SecondaryInterpretationShape ] ;
    sh:property [ sh:path ns:unmeasured ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A testimony extraction states what it does not measure (prevalence, denominators)." ] ;
    sh:property [ sh:path ( wr:consumer m:claim_id ) ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A testimony extraction names the paper claim that consumes it." ] .

wrs:TestimonySourceIdentityShape
    a sh:NodeShape ;
    sh:property [ sh:path m:catalog_url ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path m:catalog_identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path m:interviewee_names ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m:field_worker ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m:textual_mediation ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A testimony states every layer of textual mediation it passed through." ] .

wrs:TestimonyObservationShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path wr:sourceVoice ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:claim ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:location ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:observationGrade ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:validFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:notValidFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "Every testimony observation states what it is not valid for." ] .

wrs:SecondaryInterpretationShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path wr:claim ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wr:location ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:sourceGrade ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# --- Racial-eligibility legislative events ----------------------------------------------

wrs:LegislativeEventSequenceShape
    a sh:NodeShape ;
    sh:targetClass wr:LegislativeEventSequence ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:compiledOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path wr:jurisdiction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:legislativeEvent ; sh:minCount 1 ; sh:node wrs:LegislativeEventShape ] ;
    sh:property [ sh:path wr:conclusion ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:researchQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:reference ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

wrs:LegislativeEventShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path wr:eventDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path wr:legislativeState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( wr:Enacted wr:BillIntroducedNotEnacted wr:HouseApprovedSenatePostponed ) ;
        sh:message "An event's state is one of the three legislative states." ] ;
    sh:property [ sh:path wr:legalObject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:criterion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ns:limitation ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "Every legislative event states the limits on reading it." ] ;
    sh:or (
        [ sh:path wr:inference ; sh:minCount 1 ]
        [ sh:path wr:policyImplication ; sh:minCount 1 ]
    ) ;
    # A proposal one house passed and the other postponed is not law, and says how it ended.
    sh:or (
        [ sh:path wr:legislativeState ; sh:not [ sh:hasValue wr:HouseApprovedSenatePostponed ] ]
        [ sh:path wr:laterDisposition ; sh:minCount 1 ]
    ) .

# --- Growth components ------------------------------------------------------------------

wrs:GrowthComponentsShape
    a sh:NodeShape ;
    sh:targetClass wr:GrowthComponents ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:compiledOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path wr:population ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A growth-components record states the population its series counts." ] ;
    sh:property [ sh:path wr:measure ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:node wrs:GrowthSourceShape ] ;
    sh:property [ sh:path wr:interval ; sh:minCount 1 ; sh:node wrs:GrowthIntervalShape ] ;
    sh:property [ sh:path ns:forbiddenInference ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ns:limitation ; sh:minCount 1 ; sh:datatype xsd:string ] .

wrs:GrowthSourceShape
    a sh:NodeShape ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:year ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path wr:url ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ns:readStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wrs:GrowthIntervalShape
    a sh:NodeShape ;
    sh:property [ sh:path wr:startYear ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:lessThan wr:endYear ] ;
    sh:property [ sh:path wr:endYear ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path wr:netMigrationShareOfTotalGrowthPct ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100 ;
        sh:message "Net migration's share of total growth is stated, as a percentage in 0..100." ] .

# --- Quantitative documentary evidence ------------------------------------------------------

wrs:QuantitativeDocumentaryEvidenceShape
    a sh:NodeShape ;
    sh:targetClass wr:QuantitativeDocumentaryEvidence ;
    sh:property [ sh:path wr:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:compiledOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path wr:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ns:readStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:sourceRecord ; sh:minCount 1 ; sh:node wrs:LocatedSourceShape ] ;
    sh:property [ sh:path wr:rawCounts ; sh:minCount 1 ] ;
    sh:property [ sh:path wr:computedStatistics ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path wr:calculationDefinitions ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ns:unmeasured ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "Quantitative documentary evidence states what it does not measure." ] ;
    sh:property [ sh:path wr:notPooled ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "Quantitative documentary evidence states which series must not be pooled." ] ;
    # Every statistic named *_pct lies in 0..100.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A computed statistic named *_pct lies outside 0..100." ;
        sh:select """
            SELECT $this ?path ?value WHERE {
              $this <https://561.group/knowledge/white-repopulation#computedStatistics> ?stats .
              ?stats ?path ?value .
              FILTER(STRENDS(STR(?path), "_pct"))
              FILTER(?value < 0 || ?value > 100)
            }"""
    ] ;
    # Where a raw-count group states a total and at least two parts of it, the parts sum to the total.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A raw-count group's stated parts do not sum to its stated total." ;
        sh:select """
            SELECT $this ?group ?total (SUM(?v) AS ?sum) WHERE {
              $this <https://561.group/knowledge/white-repopulation#rawCounts> ?group .
              ?group <https://561.group/knowledge/white-repopulation/measure#total> ?total .
              ?group ?p ?v .
              FILTER(?p IN (
                <https://561.group/knowledge/white-repopulation/measure#white>,
                <https://561.group/knowledge/white-repopulation/measure#black>,
                <https://561.group/knowledge/white-repopulation/measure#other>,
                <https://561.group/knowledge/white-repopulation/measure#american_indian>,
                <https://561.group/knowledge/white-repopulation/measure#known_white>,
                <https://561.group/knowledge/white-repopulation/measure#other_known>,
                <https://561.group/knowledge/white-repopulation/measure#race_unknown>))
            } GROUP BY $this ?group ?total HAVING (COUNT(?v) >= 2 && SUM(?v) != ?total)"""
    ] .


wrs:LocatedSourceShape
    a sh:NodeShape ;
    sh:property [ sh:path wr:location ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wr:sourceGrade ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
