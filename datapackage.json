      "name": "births-1790-1859",
      "path": "data/derived/births-1790-1859.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "title": "Modeled births into slavery and estimated all U.S. births, by decade, 1790-1859",
      "description": "Derived by analysis/reproduce.py from data/records/2026-10-17-captive-birth-shares-source-series.json. 1790s denominator assumed at 55 per 1,000 on a 4.52 million mean population.",
      "sources": [
        {
          "title": "Hacker 2020, Slavery & Abolition 41(4), Table 1 col. 7",
          "path": "https://doi.org/10.1080/0144039X.2020.1755502"
        },
        {
          "title": "Haines and Sutch, Historical Statistics of the United States, Table Aa9-14",
          "path": "https://hsus.cambridge.org/HSUSWeb/toc/treeTablePathIdAa9-14.html"
        }
      ],
      "schema": {
        "fields": [
          {
            "name": "start_year",
            "type": "integer"
          },
          {
            "name": "end_year",
            "type": "integer"
          },
          {
            "name": "modeled_births_into_slavery",
            "type": "integer",
            "description": "Hacker 2020 modeled births into slavery in the decade",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "estimated_all_us_births",
            "type": "integer",
            "description": "Sum of annual Haines-Sutch births (thousands x 1000); 1790s assumed",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "denominator_type",
            "type": "string",
            "constraints": {
              "enum": [
                "assumed",
                "modeled"
              ]
            }
          },
          {
            "name": "share_pct",
            "type": "number",
            "description": "100 x modeled_births_into_slavery / estimated_all_us_births, 4 decimals half-even"
          }
        ],
        "primaryKey": [
          "start_year"
        ]
      },
      "hash": "sha256:1a4801bfbd4434c9e68121479c68d686bd2f1671e5758a29a3c4a6248b9f60e3",
      "bytes": 390
